### 5. `modules/home/home.service.ts`

**One parallel `Promise.all` — single round-trip:**
```ts
export async function getHomeData(userId: string): Promise<HomeData> {
  const CACHE_KEY = `home:${userId}`;
  const cached = getCache<HomeData>(CACHE_KEY);
  if (cached) return cached;

  const user = await User.findById(userId).populate('department', 'name').lean();
  if (!user) throw new NotFoundError('User');

  // All parallel — no sequential waterfalls
  const [
    verifiedBadgeCount,
    pendingRequestCount,
    closingSoon,
    teamPosts,
    unreadFlag,
  ] = await Promise.all([
    Credential.countDocuments({ studentId: userId, 'verification.status': 'verified' }),

    TeamLink.countDocuments({
      $or: [{ from: userId }, { to: userId }],
      status: 'pending',
    }),

    Event.find({
      deadline: { $gte: new Date(), $lt: new Date(Date.now() + 48 * 3600 * 1000) },
      status: 'published',
    }).sort({ deadline: 1 }).limit(5).lean(),

    // Skills match → fallback to dept + year
    (user.skills?.length
      ? TeamPost.find({ requiredSkills: { $in: user.skills }, status: 'open' }).limit(5).lean()
      : TeamPost.find({ department: user.department, status: 'open' }).limit(5).lean()
    ),

    Notification.exists({ userId, readAt: null }),
  ]);

  // Empty-key omission — spec: "empty arrays omitted from response"
  const data: HomeData = {
    user: {
      name:               user.name,
      branch:             (user as { department: { name?: string } }).department?.name ?? '',
      year:               user.year ?? null,
      verifiedBadgeCount,
    },
    unreadNotificationsFlag: !!unreadFlag,
  };
  if (pendingRequestCount > 0)  data.pendingRequestCount  = pendingRequestCount;
  if (closingSoon.length)       data.closingSoonEvents    = closingSoon;
  if (teamPosts.length)         data.matchedTeamPosts     = teamPosts;

  setCache(CACHE_KEY, data, 30);  // 30s TTL
  return data;
}
```

