## Server — 10 new files

### 1. `modules/notifications/notification.service.ts`

Core of F-9. Two responsibilities: write in-app notification + optionally send email.

**Discriminated union for type safety:**
```ts
type NotifPayload =
  | { type: 'event_new';         eventId: string; eventTitle: string }
  | { type: 'deadline';          eventId: string; eventTitle: string; hoursLeft: 48 | 4 }
  | { type: 'link_received';     linkId: string;  fromName: string }
  | { type: 'link_update';       linkId: string;  status: 'accepted' | 'declined' }
  | { type: 'credential_update'; credId: string;  status: 'verified' | 'rejected' }
  | { type: 'link_expiring';     linkId: string };
```

**`sendNotification(userId, payload): void` — fire-and-forget**

The function is synchronous from the caller's perspective (`void` return — not `async`).
Spec: "notification sending is async — never blocks API response."

```ts
export function sendNotification(userId: string, payload: NotifPayload): void {
  void _send(userId, payload);   // Promise dropped intentionally
}

async function _send(userId: string, payload: NotifPayload): Promise<void> {
  // 1. Always: write in-app notification
  await Notification.create({ userId, type: payload.type, payload });

  // 2. Email — only for high-value types
  if (shouldEmail(payload.type)) {
    const user = await User.findById(userId).select('email name').lean();
    if (user) {
      await sendNotificationEmail({
        to:       user.email,
        name:     user.name,
        ...buildEmailPayload(payload),
      });
    }
  }
}

function shouldEmail(type: NotificationType): boolean {
  return ['event_new', 'credential_update'].includes(type)
    || (type === 'deadline' && /* hoursLeft === 48 — checked via payload */);
}
```

**Email payload per type:**

| Type | Subject | Body | CTA |
|------|---------|------|-----|
| `event_new` | "New event: {title}" | Your dept has a new event. Register before the deadline. | View Event |
| `deadline` 48h | "Deadline in 48h: {title}" | Registration closes in 48 hours. | Register Now |
| `credential_update` verified | "Certificate Verified ✓" | Your {course} certificate has been verified. | View Badges |
| `credential_update` rejected | "Certificate Needs Attention" | Your {course} certificate needs review. Reason: {reason}. | View Badges |

**`getNotifications(userId, cursor?, limit?)`**
```ts
// Cursor-based pagination (ObjectId cursor — stable on fast-inserting collection)
const query = cursor
  ? { userId, _id: { $lt: cursor } }  // older than cursor
  : { userId };
return Notification.find(query).sort({ createdAt: -1 }).limit(limit + 1);
// If results.length > limit: pop last → set nextCursor
```

**`markRead(userId, notificationId)`**
```ts
// findOneAndUpdate with userId guard — prevents marking another user's notification
Notification.findOneAndUpdate(
  { _id: notificationId, userId, readAt: null },
  { readAt: new Date() }
)
// No-op if not found or already read
```

