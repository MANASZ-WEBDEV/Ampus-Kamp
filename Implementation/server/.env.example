# ── Server Configuration ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/campus_innovation?retryWrites=true&w=majority

# JWT — MUST be at least 32 random characters
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-very-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=30d

# Frontend URL (used for CORS)
CLIENT_URL=http://localhost:5173

# ── File Storage (Cloudinary) ─────────────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── LLM API (for event extraction — F-3) ─────────────────────────────────────
# Gemini: https://aistudio.google.com/app/apikey
# Groq:   https://console.groq.com
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gemini-1.5-flash

# ── Email (SMTP — for OTP and notifications) ──────────────────────────────────
# Free options: Resend, Brevo, Mailgun free tier
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USER=resend
EMAIL_PASS=your-smtp-password
EMAIL_FROM=noreply@yourdomain.com

# ── Web Push — VAPID keys (for PWA push notifications — F-9) ─────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@yourdomain.com
